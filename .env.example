# Dhan API credentials (web.dhan.co → My Profile → Access DhanHQ APIs)
# Self-generated access tokens expire 24 hours after creation. A token saved on the Settings
# page (stored in Redis for 24 hours) takes precedence; DHAN_ACCESS_TOKEN is the fallback.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Redis (Upstash REST) for the access token saved on the Settings page (optional).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# App login (single user). Changing the password signs out existing sessions.
USER_NAME=
USER_PASSWORD=

# Live market feed (optional). FEED_CAPTURE=1 records raw feed frames to captures/feed/
# FEED_CAPTURE=1

# File storage for downloaded option instruments (Settings). Without S3_BUCKET, files go to
# DATA_DIR (default ./data), which must be writable: serverless hosts such as Vercel need S3.
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_PREFIX=option-trader/
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for S3-compatible services (Cloudflare R2, MinIO)
# DATA_DIR=/var/lib/option-trader
