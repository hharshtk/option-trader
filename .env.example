# Dhan API credentials (web.dhan.co → My Profile → Access DhanHQ APIs)
# Self-generated access tokens expire 24 hours after creation.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# App login (single user). Changing the password signs out existing sessions.
USER_NAME=
USER_PASSWORD=

# Live market feed service (npm run feed). Both settings are optional.
# FEED_PORT=3010
# FEED_CAPTURE=1 records raw feed frames to services/feed/captures/
