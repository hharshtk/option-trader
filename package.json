{
  "name": "option-trader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "engine": "node --env-file-if-exists=.env.local src/engine/main.ts",
    "engine:dev": "node --watch --env-file-if-exists=.env.local src/engine/main.ts",
    "engine:replay": "node --env-file-if-exists=.env.local src/engine/main.ts --replay",
    "scalp:lab": "node src/engine/trading/scalp-lab-cli.ts",
    "decide": "node --env-file-if-exists=.env.local src/engine/decide/cli.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:feed": "node --test src/lib/live/feed/*.test.ts",
    "test:scrips": "node --test src/lib/dhan/*.test.ts",
    "test:engine": "node --test \"src/engine/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@openrouter/sdk": "^1.5.105",
    "lightweight-charts": "5.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
